{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1434;Database=ErpBE_Test;User Id=sa;Password=TestPassword123!;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "YourSuperUltraMegaSecureSecretKey123!",
    "Issuer": "ErpBE.API",
    "Audience": "ErpBE.Client",
    "ExpiryMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "ErpBE": "Information"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId"]
  },
  "Audit": {
    "Enabled": false,
    "TrackPropertyChanges": false,
    "TrackOldValues": false,
    "TrackNewValues": false
  },
  "AllowedHosts": "*"
}
