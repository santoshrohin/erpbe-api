{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;TrustServerCertificate=true;"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.MSSqlServer"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;TrustServerCertificate=true;",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "schemaName": "dbo",
            "autoCreateSqlTable": true
          },
          "restrictedToMinimumLevel": "Information",
          "columnOptionsSection": {
            "additionalColumns": [
              {
                "ColumnName": "UserId",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "RequestId",
                "DataType": "nvarchar",
                "DataLength": 50
              },
              {
                "ColumnName": "ActionName",
                "DataType": "nvarchar",
                "DataLength": 100
              }
            ]
          }
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId", "WithProcessId"]
  },
  "Audit": {
    "Enabled": true,
    "TrackPropertyChanges": true,
    "TrackOldValues": true,
    "TrackNewValues": true
  },
  "JwtSettings": {
    "Secret": "YOUR_PRODUCTION_SECRET_KEY_HERE",
    "Issuer": "ErpBE.API",
    "Audience": "ErpBE.API",
    "ExpiryInMinutes": 60
  }
}
